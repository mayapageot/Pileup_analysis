    "    fig,(ax1,ax2) = plt.subplots(1,2,figsize=(12,5))\n",
    "    ax1.loglog(np.fft.rfftfreq(window_size,1e-4),nps[:window_size//2+1],label=f\"Channel {channel}\")\n",
    "    ax1.set_title(f\"NPS Channel {channel}\")\n",
